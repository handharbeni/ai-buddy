# BAPENDA Local AI Platform - Environment Configuration
# Copy this to .env and fill in your real values.
# Never commit .env to version control.

# ── LLM Settings ─────────────────────────────────────────────────
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=bapenda-ai:latest
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ── JWT Auth ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRE_MIN=15

# ── Oracle (BATAMAI) ─────────────────────────────────────────────
ORACLE_BATAMAI_HOST=localhost
ORACLE_BATAMAI_PORT=1521
ORACLE_BATAMAI_SERVICE=simpbb
ORACLE_BATAMAI_USER=batamai
ORACLE_BATAMAI_PASSWORD=batamai2026

# ── Server ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

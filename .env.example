# Local AI Data Intelligence Platform - Environment Configuration
# Copy to .env and customize for your project.
# Never commit .env to version control.
#
# To use: docker compose --env-file .env up
# Or for local development: backend reads .env from its working directory.

# ── Project Branding ─────────────────────────────────────────────────────
# Customize these for your organization / project
APP_NAME=BAPENDA AI Platform
APP_SHORT_NAME=BAPENDA
APP_TAGLINE=Local AI Data Intelligence Platform
APP_INSTITUTION=BAPENDA Batam
APP_DOMAIN=tax
APP_VERSION=1.0.0

# ── LLM ──────────────────────────────────────────────────────────────────
# Set LLM_BACKEND=ollama (local) or vllm (GPU server)
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
# Model must be downloaded in Ollama first: ollama pull <model>
LLM_MODEL=bapenda-ai:latest
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ── Auth ──────────────────────────────────────────────────────────────────
# Change this to a long random string in production (min 32 chars)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=15

# ── RAG / Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulations
EMBEDDING_MODEL=BAAI/bge-m3

# ── Database: Oracle ──────────────────────────────────────────────────────
# Naming pattern: ORACLE_<NAME>_*
# Supports multiple Oracle DBs — add ORACLE_FOO_* for a second DB named "foo"
USE_MOCK_DB=1                    # Set to 0 when real credentials provided
ORACLE_BATAMAI_HOST=10.11.0.252
ORACLE_BATAMAI_PORT=1521
ORACLE_BATAMAI_SERVICE=simpbb
ORACLE_BATAMAI_USER=ai_readonly
ORACLE_BATAMAI_PASSWORD=your_password_here
ORACLE_BATAMAI_READONLY=true

# Example: add a second Oracle DB
# ORACLE_FOO_HOST=192.168.1.10
# ORACLE_FOO_PORT=1521
# ORACLE_FOO_SERVICE=orcl
# ORACLE_FOO_USER=ai_readonly
# ORACLE_FOO_PASSWORD=another_password

# ── Database: PostgreSQL ──────────────────────────────────────────────────
# Naming pattern: POSTGRES_<NAME>_*
POSTGRES_PRIMARY_HOST=
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_DB=
POSTGRES_PRIMARY_USER=
POSTGRES_PRIMARY_PASSWORD=

# ── Database: MySQL ──────────────────────────────────────────────────────
# Naming pattern: MYSQL_<NAME>_*
MYSQL_PRIMARY_HOST=
MYSQL_PRIMARY_PORT=3306
MYSQL_PRIMARY_DB=
MYSQL_PRIMARY_USER=
MYSQL_PRIMARY_PASSWORD=

# ── Server & Network ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
FRONTEND_PORT=3000
QDRANT_PORT=6333
OLLAMA_PORT=11434
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Secrets Management ────────────────────────────────────────────────────
# In production, use Docker secrets or an external secrets manager (Vault, AWS SM, etc.)
# For Kubernetes: use K8s Secrets mounted as env vars or files.

# ── VPN (OpenVPN — for reaching remote databases behind VPN) ──────────────
# Files: docker/vpn/config.ovpn  +  docker/vpn/auth.txt
# Activate VPN profile: docker compose --profile vpn up
# VPN_SUBNETS=10.11.0.0/16   # comma-separated CIDRs to route through VPN tunnel
# VPN_SUBNETS=               # leave empty to route ALL traffic through VPN
#
# ── RAG (optional) ──────────────────────────────────────────────────────────
# Activate: docker compose --profile rag up
# Starts RAG service on port 8002 with Qdrant + embedding model
EMBEDDING_MODEL=BAAI/bge-m3
RAG_BASE_URL=http://localhost:8002

# ── Multi-VPN (per-database tunnel) ──────────────────────────────────────
# Activate: docker compose --profile vpn-multi up
# Each .ovpn file in docker/vpn/ becomes its own tunnel (tun10, tun11, ...).
# iptables policy routing sends traffic to the right tunnel by destination subnet.
# Files must follow naming: <name>.ovpn + auth_<name>.txt (or fallback auth.txt)
#
# ORACLE_SUBNETS=10.11.0.0/16         # routed via docker/vpn/oracle.ovpn
# MYSQL_SUBNETS=192.168.50.0/24       # routed via docker/vpn/mysql.ovpn
# POSTGRES_SUBNETS=172.16.0.0/12     # routed via docker/vpn/postgres.ovpn
# SINGLE_VPN_SUBNETS=10.11.0.0/16   # for single-VPN mode (profile vpn)
